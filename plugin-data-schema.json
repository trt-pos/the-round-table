{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Plugin Metadata Schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "vendor": {
      "type": "string"
    },
    "vendor-url": {
      "type": "string",
      "format": "uri"
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+$"
          }
        },
        "required": ["id", "version"]
      },
      "contains": {
        "type": "object",
        "properties": {
          "id": { "const": "core" }
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "required": ["id", "version"]
      }
    }
  },
  "required": [
    "name",
    "id",
    "description",
    "version",
    "vendor",
    "vendor-url",
    "dependencies"
  ],
  "additionalProperties": false
}
